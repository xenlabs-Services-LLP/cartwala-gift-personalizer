{%- comment -%} Global cart drawer, injected once in header {%- endcomment -%}
<div id="cart-drawer" class="cart-drawer" data-free-shipping-threshold="{{ settings.free_shipping_threshold | default: 999 }}">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Your cart">
    <div class="cart-drawer__head">
      <strong>Your Cart (<span data-cart-count>{{ cart.item_count }}</span>)</strong>
      <button class="icon-btn" data-cart-close aria-label="Close cart">{% render 'icon', name: 'close' %}</button>
    </div>

    {% if settings.free_shipping_threshold %}
      <div style="padding:1rem 1.25rem 0;">
        <div class="free-shipping-bar"><div class="free-shipping-bar__fill" data-free-shipping-fill style="width:0%;"></div></div>
        <p class="text-muted" style="font-size:.78rem;" data-free-shipping-label>Add items to unlock free shipping</p>
      </div>
    {% endif %}

    <div class="cart-drawer__items" data-cart-items>
      <div class="empty-state"><p>Your cart is empty.</p><a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">Start Shopping</a></div>
    </div>

    <div class="cart-drawer__footer">
      <div style="display:flex;justify-content:space-between;font-weight:700;margin-bottom:1rem;">
        <span>Subtotal</span>
        <span data-cart-subtotal>₹0</span>
      </div>
      <a href="/checkout" class="btn btn-primary btn-block" style="margin-bottom:.6rem;">Proceed to Checkout</a>
      <button type="button" class="btn btn-outline btn-block" data-cart-close>Continue shopping</button>
      <p class="text-muted" style="text-align:center;font-size:.75rem;margin-top:.85rem;">🔒 Secure checkout · 📦 Careful packaging</p>
    </div>
  </div>
</div>
