<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title }}{% if current_tags %} – tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>{% render 'meta-tags' %}{{ content_for_header }}
{{ 'base.css' | asset_url | stylesheet_tag }}{{ 'cartwala-cart-ui-fix.css' | asset_url | stylesheet_tag }}{{ 'cartwala-cart-drawer-styles.css' | asset_url | stylesheet_tag }}
<script>document.documentElement.className=document.documentElement.className.replace('no-js','js');window.Cartwala={routes:{cart_add_url:'{{ routes.cart_add_url }}',cart_change_url:'{{ routes.cart_change_url }}',cart_url:'{{ routes.cart_url }}',predictive_search_url:'{{ routes.predictive_search_url }}'}};</script>
</head><body><a class="skip-to-content-link" href="#MainContent">Skip to content</a>{% sections 'header-group' %}<main id="MainContent" role="main">{{ content_for_layout }}</main>{% sections 'footer-group' %}{% render 'cart-drawer' %}{% render 'search-drawer' %}<div id="cw-toast" class="toast" role="status" aria-live="polite"></div>
<script>
(() => {
  const inEditor = target => target instanceof Element && Boolean(target.closest('#signature-day-store, .teeinblue-editor, [data-personalizer-editor], .mug-design-studio, dialog'));
  for (const name of ['gesturestart', 'gesturechange']) {
    document.addEventListener(name, event => {
      if (!inEditor(event.target)) event.preventDefault();
    }, { passive: false });
  }
  document.addEventListener('touchmove', event => {
    if (event.touches.length > 1 && !inEditor(event.target)) event.preventDefault();
  }, { passive: false });
})();
</script>
<script src="{{ 'theme.js' | asset_url }}" defer></script><script src="{{ 'cartwala-quantity-fix.js' | asset_url }}" defer></script><script src="{{ 'cartwala-cart-flow-fix.js' | asset_url }}" defer></script><script src="{{ 'cartwala-personalizer-complete-fix.js' | asset_url }}" defer></script><script src="{{ 'cartwala-cart-ui-fix.js' | asset_url }}" defer></script><script src="{{ 'cartwala-cart-open-fix.js' | asset_url }}" defer></script></body></html>
