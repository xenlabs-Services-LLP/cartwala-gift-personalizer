// The print canvas contains the artwork only. Its 2480 × 3508 pixels match
// A4 at 300 DPI; the customer PDF instead uses the on-shirt mockup previews.
const PRINT_W=2480,PRINT_H=3508,PROXY='/apps/cartwala-signature-day';
const orderStatus=root.querySelector('#orderStatus');
let originalUploadTask=Promise.resolve();
function queueOriginalUploads(persons){originalUploadTask=originalUploadTask.then(async()=>{for(const person of persons){try{await ensureOriginalUploaded(person,people.indexOf(person))}catch(_){/* Keep the original in IndexedDB; checkout can retry the upload. */}}});}
async function ensureOriginalUploaded(person,index){
