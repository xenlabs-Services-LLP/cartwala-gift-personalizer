}
function fileBlob(canvas,type,quality){return new Promise((resolve,reject)=>canvas.toBlob(blob=>blob?resolve(blob):reject(new Error('Could not prepare print image')),type,quality))}
async function uploadAsset(blob,name){const form=new FormData();form.append('intent','upload');form.append('file',blob,name);const response=await fetch(PROXY,{method:'POST',body:form});const result=await response.json().catch(()=>({}));if(!response.ok||!result.url)throw new Error(result.error||(response.status===404||response.headers.get('content-type')?.indexOf('application/json')===-1?'Photo upload connection is not active on this store yet. Please try again later.':'Could not save '+name+' (HTTP '+response.status+'). Please try again.'));return result.url}
async function uploadBatchAssets(assets,label){
 const total=assets.reduce((size,asset)=>size+asset.blob.size,0);
 if(assets.length===1||total>18*1024*1024)return Promise.all(assets.map(asset=>uploadAsset(asset.blob,asset.name)));
 const form=new FormData();form.append('intent','upload_batch');assets.forEach(asset=>form.append('file',asset.blob,asset.name));
 const response=await new Promise((resolve,reject)=>{
  const xhr=new XMLHttpRequest();xhr.open('POST',PROXY);
  xhr.upload.onprogress=e=>{if(e.lengthComputable)orderStatus.textContent='Uploading '+label+': '+Math.round(e.loaded/e.total*100)+'% of '+(e.total/1048576).toFixed(1)+' MB';};
  xhr.upload.onload=()=>{orderStatus.textContent='Shopify processing '+label+'…'};
  xhr.onload=()=>{let result={};try{result=JSON.parse(xhr.responseText)}catch(_){}resolve({status:xhr.status,ok:xhr.status>=200&&xhr.status<300,result})};
  xhr.onerror=()=>reject(new Error('Network interrupted while uploading '+label+'. Completed T-shirts are saved; please retry.'));
  xhr.send(form);
 });
 const result=response.result;
 if(response.status===404||result.error==='Invalid upload')return Promise.all(assets.map(asset=>uploadAsset(asset.blob,asset.name)));
 if(!response.ok||!Array.isArray(result.urls)||result.urls.length!==assets.length)throw new Error(result.error||'Could not save the T-shirt print files. Please try again.');
 return result.urls;
}
async function assembleFrontBatch(baseUrl,layout,items){
