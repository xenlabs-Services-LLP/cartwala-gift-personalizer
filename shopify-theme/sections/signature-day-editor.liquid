 form.append('x',String(layout.cc*layout.cw));form.append('y',String(layout.cr*layout.ch));form.append('width',String(layout.center*layout.cw));form.append('height',String(layout.center*layout.ch));
 items.forEach(item=>{form.append('tile',item.tile,'signature-center-'+(item.index+1)+'.jpg');form.append('preview',item.preview,'signature-shirt-'+(item.index+1)+'.jpg')});
 const label='T-shirts '+(items[0].index+1)+'–'+(items.at(-1).index+1)+' of '+people.length;
 return new Promise((resolve,reject)=>{const xhr=new XMLHttpRequest();xhr.open('POST',PROXY);
  xhr.upload.onprogress=e=>{if(e.lengthComputable)orderStatus.textContent='Uploading '+label+': '+Math.round(e.loaded/e.total*100)+'% of '+(e.total/1048576).toFixed(1)+' MB'};
  xhr.upload.onload=()=>{orderStatus.textContent='Creating A4 print PDF for '+label+'…'};
  xhr.onload=()=>{let data={};try{data=JSON.parse(xhr.responseText)}catch(_){}if(xhr.status>=200&&xhr.status<300&&data.printUrl&&data.previewUrls?.length===items.length)resolve(data);else reject(new Error(data.error||'Could not create the A4 print PDF. Try again.'))};
  xhr.onerror=()=>reject(new Error('Network interrupted. Saved T-shirts are kept; tap Add to cart to retry.'));xhr.send(form)})
}
