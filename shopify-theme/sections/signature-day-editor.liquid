    let sharedBaseUrl=printCache.sharedBaseUrl;
    if(base&&!sharedBaseUrl){orderStatus.textContent='Saving shared A4 collage once…';sharedBaseUrl=await uploadAsset(await fileBlob(base,'image/jpeg',.9),'signature-a4-shared.jpg');printCache.sharedBaseUrl=sharedBaseUrl;await saveDraft().catch(()=>{})}
    let pending=[];
    async function saveFrontBatch(){if(!pending.length)return;const current=pending;pending=[];const result=await assembleFrontBatch(sharedBaseUrl,layout,current);current.forEach((item,page)=>{
     const print={front:result.printUrl+'#page='+(page+1)},preview={front:result.previewUrls[page]};
     printCache.prints[item.index]=print;printCache.previews[item.index]=preview;printUrls[item.index]=print;previewUrls[item.index]=preview;
    });await saveDraft().catch(()=>{})}
    for(let i=0;i<people.length;i++){
     if(printCache.previews[i]?.front&&printCache.prints[i]?.front){await saveFrontBatch();previewUrls[i]=printCache.previews[i];printUrls[i]=printCache.prints[i];continue}
     orderStatus.textContent='Preparing T-shirt '+(i+1)+' of '+people.length+'…';
     const center=await makeCenterTile(layout,i),tile=await fileBlob(center,'image/jpeg',.9);center.width=center.height=0;
     selected=i;side='front';draw();const preview=await fileBlob(canvas,'image/jpeg',.82);
     if(pending.length&&pending.reduce((sum,item)=>sum+item.tile.size+item.preview.size,0)+tile.size+preview.size>18*1024*1024)await saveFrontBatch();
     pending.push({index:i,tile,preview});if(pending.length>=4)await saveFrontBatch();
     await new Promise(resolve=>setTimeout(resolve,0));
    }
    await saveFrontBatch();
   }else{
   let pending=[],cacheSaveTask=Promise.resolve();const inFlight=[];
   function savePending(){
    if(!pending.length)return;
    const current=pending;pending=[];
    const label='T-shirts '+(current[0].index+1)+(current.length>1?'–'+(current.at(-1).index+1):'')+' of '+people.length;
    const job=(async()=>{
     const urls=await uploadBatchAssets(current.flatMap(item=>item.assets),label);let offset=0;
     for(const item of current){
      const values=urls.slice(offset,offset+item.assets.length);offset+=item.assets.length;
      const print={front:values[0]},preview={front:values[1]};
      if(includeBack){print.back=values[2];preview.back=values[3]}
      printCache.prints[item.index]=print;printCache.previews[item.index]=preview;
      printUrls[item.index]=print;previewUrls[item.index]=preview;
     }
     cacheSaveTask=cacheSaveTask.then(()=>saveDraft().catch(()=>{}));await cacheSaveTask;
    })().then(()=>({ok:true}),error=>({ok:false,error}));
    inFlight.push(job);
   }
   async function finishOldest(){const completed=await inFlight.shift();if(!completed.ok)throw completed.error}
   for(let i=0;i<people.length;i++){
    if(printCache.previews[i]?.front&&printCache.prints[i]?.front&&(!includeBack||(printCache.previews[i]?.back&&printCache.prints[i]?.back))){savePending();previewUrls[i]=printCache.previews[i];printUrls[i]=printCache.prints[i];continue}
    orderStatus.textContent='Preparing T-shirt '+(i+1)+' of '+people.length+'…';
    const frontPrint=await makeFrontPrint(base,layout,i);
    const frontBlob=await fileBlob(frontPrint,'image/jpeg',.9);frontPrint.width=frontPrint.height=0;
    selected=i;side='front';draw();const frontPreviewBlob=await fileBlob(canvas,'image/jpeg',.82);
    const assets=[{blob:frontBlob,name:'signature-a4-front-'+(i+1)+'.jpg'},{blob:frontPreviewBlob,name:'signature-shirt-front-'+(i+1)+'.jpg'}];
    if(includeBack){
     const backPrint=makeBackPrint(i);const backBlob=await fileBlob(backPrint,'image/png');backPrint.width=backPrint.height=0;
     side='back';draw();const backPreviewBlob=await fileBlob(canvas,'image/jpeg',.82);
     assets.push({blob:backBlob,name:'signature-back-print-'+(i+1)+'.png'},{blob:backPreviewBlob,name:'signature-shirt-back-'+(i+1)+'.jpg'});
    }
    if(pending.length&&(pending.reduce((count,item)=>count+item.assets.length,0)+assets.length>4||pending.reduce((size,item)=>size+item.assets.reduce((sum,asset)=>sum+asset.blob.size,0),0)+assets.reduce((sum,asset)=>sum+asset.blob.size,0)>18*1024*1024))savePending();
    pending.push({index:i,assets});
    if(pending.reduce((count,item)=>count+item.assets.length,0)>=4)savePending();
    if(inFlight.length>=2)await finishOldest();
    await new Promise(resolve=>setTimeout(resolve,0));
   }
   savePending();while(inFlight.length)await finishOldest();
   }
  }finally{if(base)base.width=base.height=0}
  orderStatus.textContent='Connecting previews and print files to your order…';
  let designId=printCache.designId;
  if(!designId){const response=await fetch(PROXY,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({previewUrls,printUrls,sourceUrls,shirtSizes:people.map(person=>person.size),backPrint:includeBack})});const saved=await response.json();if(!response.ok||!saved.designId)throw new Error(saved.error||'Could not save design');designId=saved.designId;printCache.designId=designId;await saveDraft().catch(()=>{})}
  const grouped=new Map();people.forEach((person,i)=>{const id=variantIds[i];if(!grouped.has(id))grouped.set(id,{id,quantity:0,properties:{'_Cartwala Signature Day Design':designId,'T-shirt size':person.size,'_T-shirt preview':previewUrls[i].front,'_Cartwala Preview':previewUrls[i].front}});grouped.get(id).quantity++});
  const cartResponse=await fetch('/cart.js');if(!cartResponse.ok)throw new Error('Could not check the cart. Please try again.');const cart=await cartResponse.json();
  const items=[...grouped.values()].map(item=>{const existing=(cart.items||[]).filter(line=>String(line.variant_id)===String(item.id)&&line.properties?.['_Cartwala Signature Day Design']===designId).reduce((sum,line)=>sum+line.quantity,0);return {...item,quantity:item.quantity-existing}});
  if(items.some(item=>item.quantity<0))throw new Error('This design already has extra T-shirts in the cart. Review the cart before adding again.');
  const missing=items.filter(item=>item.quantity>0);
  if(missing.length){const added=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:missing})});if(!added.ok){const problem=await added.json().catch(()=>({}));throw new Error('Design saved, but cart rejected the T-shirts: '+(problem.description||problem.message||'HTTP '+added.status)+'. Please retry. Your previews are saved.')}}
  orderStatus.textContent='T-shirts added to your cart.';
  document.dispatchEvent(new CustomEvent('cartwala:item-added'));
 }catch(error){orderStatus.textContent=error.message||'Could not prepare the order. Please try again.'}finally{selected=priorSelected;side=priorSide;draw();confirming=false;button.disabled=false}
};
sample(15);updateBackControls();restoreDraft();

})();
</script>
