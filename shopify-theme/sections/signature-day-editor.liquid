   selected=i;side='front';draw();const preview={front:await uploadAsset(await fileBlob(canvas,'image/jpeg',.9),'signature-shirt-front-'+(i+1)+'.jpg')};
   if(includeBack){const backPrint=makeBackPrint(i);print.back=await uploadAsset(await fileBlob(backPrint,'image/png'),'signature-back-print-'+(i+1)+'.png');backPrint.width=backPrint.height=0;side='back';draw();preview.back=await uploadAsset(await fileBlob(canvas,'image/jpeg',.9),'signature-shirt-back-'+(i+1)+'.jpg')}
   previewUrls.push(preview);printUrls.push(print);await new Promise(resolve=>setTimeout(resolve,0));
  }
  base.width=base.height=0;
  orderStatus.textContent='Connecting previews and print files to your order…';
  const response=await fetch(PROXY,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({previewUrls,printUrls,sourceUrls,shirtSizes:people.map(person=>person.size),backPrint:includeBack})});const saved=await response.json();if(!response.ok||!saved.designId)throw new Error(saved.error||'Could not save design');
  const items=people.map((person,i)=>({id:variantIds[i],quantity:1,properties:{'_Cartwala Signature Day Design':saved.designId,'Person':person.name,'T-shirt size':person.size,'_T-shirt preview':previewUrls[i].front}}));
  const cartResponse=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items})});if(!cartResponse.ok)throw new Error('Design saved, but the T-shirts could not be added to cart. Please contact Cartwala before ordering.');
  window.location.assign('/checkout');
 }catch(error){orderStatus.textContent=error.message||'Could not prepare the order. Please try again.'}finally{selected=priorSelected;side=priorSide;draw();confirming=false;button.disabled=false}
};
sample(15);updateBackControls();restoreDraft();

})();
