<div id="signature-day-store">
  <section class="product-intro" id="productIntro">
   <div class="product-photo"><img src="https://cdn.shopify.com/s/files/1/0803/7931/4361/files/signature-day-white-shirt-mockup.png?v=1790180938" alt="White Signature Day T-shirt front mockup" width="760" height="728"></div>
   <div class="product-details">
    <h1>{{ product.title | escape }}</h1>
    <p>A4 photo collage on a white T-shirt. Upload one photo for each T-shirt and choose a different main photo for each person.</p>
    <div class="product-offer"><span class="regular-price">₹250</span><strong>₹150 per T-shirt</strong><span>For 1–10 T-shirts</span></div>
    <div class="product-tier"><strong>11 or more T-shirts: ₹130 each</strong><span>The lower price applies to every T-shirt in the order.</span></div>
    <div class="product-tier"><strong>Optional back print: +₹30 per T-shirt</strong><span>Choose it for the whole order or leave every back blank.</span></div>
    <p class="product-count" id="productCount" aria-live="polite">The order total is calculated from the number of photos you upload.</p>
    <button class="next customize-button" id="customizeNow" type="button">Customize Now</button>
   </div>
  </section>
  <div class="editor" id="editor" hidden>
  <button class="back-to-product" id="backToProduct" type="button">← Product details</button>
  <h2 class="sd-heading">Customize {{ product.title | escape }}</h2>
  <p class="sd-subheading">A4 group collage preview · one uploaded photo = one T-shirt</p>
  <div class="sd-main">
 <section class="panel" id="setup">
  <h2>One class, one design per person</h2>
  <p>Every photo appears around the collage. Choose a person to see their portrait highlighted in the center of their T-shirt.</p>
  <label>Try a group size</label><div class="presets"><button id="p15" type="button">15 people</button><button id="p30" type="button">30 people</button></div>
  <label for="files">Add your group's photos</label>
  <input class="photo-input" id="files" type="file" accept="image/*" aria-label="Add one photo from your phone">
  <label class="files-upload" for="filesFallback">Add several photos from Files</label><input class="photo-input" id="filesFallback" type="file" accept=".jpg,.jpeg,.png,.webp" multiple>
  <button type="button" id="resetDesign" class="reset-design">Reset all photos and design</button>
  <p class="status" id="uploadStatus" role="status">Upload photos in any shape. The design crops every tile to one matching ratio between 1:1 and 2:3; the middle photo uses the same ratio at four times the width and height. On your phone, use Chrome if the picker closes inside ChatGPT.</p>
  <section class="back-config" id="backConfig">
   <h3>Back print for the whole order</h3>
   <label class="back-order-toggle"><input type="checkbox" id="includeBack"> Add back print to every T-shirt (+₹30 each)</label>
   <p>All T-shirts in this group have the same front/back choice. Select the details only if you want back printing.</p>
   <div class="back-choices" id="backChoices" hidden>
    <label><input type="checkbox" data-back-field="college"> College name</label>
    <label><input type="checkbox" data-back-field="name"> Student name</label>
    <label><input type="checkbox" data-back-field="roll"> Roll number</label>
    <label><input type="checkbox" data-back-field="group"> Group name</label>
    <label><input type="checkbox" data-back-field="year"> Academic year</label>
   </div>
   <div class="back-shared" id="backShared" hidden>
    <label data-shared="college">College name <input type="text" data-back-value="college" maxlength="70" placeholder="Enter college name"></label>
    <label data-shared="group">Group name <input type="text" data-back-value="group" maxlength="50" placeholder="Enter group name"></label>
    <label data-shared="year">Academic year <input type="text" data-back-value="year" maxlength="30" placeholder="For example, 2025–2026"></label>
   </div>
   <p class="back-help" id="backHelp" hidden>For individual names and roll numbers, use the photo list below. Back printing applies to every shirt.</p>
   <p class="back-validation" id="backValidation" role="alert" hidden></p>
  </section>
  <div class="pricing" aria-live="polite"><strong>Price estimate</strong><div id="priceSummary"></div><small>Regular front price: ₹250 per shirt. 1–10 shirts: ₹150 each; 11+ shirts: ₹130 each. Back print: +₹30 per shirt when selected for the whole order.</small></div>
  <p class="notice">This preview stays in your browser. Sample portraits are colored placeholders; upload your photos to calculate the order price.</p>
  <div class="counts" id="counts"></div>
  <div class="roster" id="roster"></div>
  <button class="next" id="nextStep" type="button">Next: preview T-shirts →</button>
 </section>
 <section class="stage" id="previews" tabindex="-1" hidden>
  <div class="toolbar"><strong id="previewTitle"></strong><button type="button" id="download">Save this T-shirt preview</button></div>
  <div class="price-inline" id="previewPrice" aria-live="polite"></div>
  <div class="side-tabs" role="group" aria-label="T-shirt side"><button id="frontView" type="button" aria-pressed="true">Front</button><button id="backView" type="button" aria-pressed="false">Back</button></div>
  <canvas id="preview" width="1200" height="1400" aria-label="T-shirt preview"></canvas>
  <p class="back-preview-note" id="backPreviewNote" role="status" hidden></p>
  <div class="preview-nav"><button type="button" id="cropCenter">Crop selected person's photo</button><button type="button" id="previousShirt">← Previous T-shirt</button><button type="button" id="nextShirt">Next T-shirt →</button><button type="button" id="backToPhotos">Change photos / sizes</button></div>
  <button class="next review-button" id="reviewOrder" type="button">Check previews and total →</button>
  <p class="notice">Front collage: A4 proportion (210 × 297 mm). The back text layout is a visual preview; its final print size, placement and order integration need production testing.</p>
 </section>
</div>
<section class="review-panel" id="orderReview" tabindex="-1" hidden>
 <h2>Review your T-shirts</h2>
 <p>Check every front and back preview before confirming the design.</p>
 <div id="reviewSummary"></div>
 <button type="button" id="returnToPreview">← Check previews again</button>
 <button type="button" class="next" id="confirmOrder">Add T-shirts to cart</button>
 <p class="status" id="orderStatus" role="status">Your original photos and print files will be saved before checkout opens.</p>
</section>
</div>

<dialog id="cropDialog" class="crop-dialog" aria-labelledby="cropTitle">
 <h2 id="cropTitle">Adjust photo</h2>
 <p>Drag to position the face. Zoom in or out, then save. This crop is used in the collage and the center portrait.</p>
 <canvas id="cropCanvas" width="340" height="440" aria-label="Photo crop area"></canvas>
 <label for="cropZoom">Zoom</label><input id="cropZoom" type="range" min="1" max="3" step="0.02" value="1">
 <div class="crop-actions"><button type="button" id="cropReset">Reset</button><button type="button" id="cropCancel">Cancel</button><button type="button" id="cropSave" class="next">Save crop</button></div>
</dialog>
<dialog id="savedDialog" class="crop-dialog" aria-labelledby="savedTitle">
 <h2 id="savedTitle">Preview ready to save</h2>
 <p id="saveMessage">On iPhone, touch and hold the image below, then choose Save to Photos. You can also tap Download PNG.</p>
 <img id="savedImage" class="saved-image" alt="Saved T-shirt preview" width="280" height="327">
 <a id="downloadLink" class="download-link" download="signature-day-preview.png">Download PNG</a>
 <button id="savedClose" type="button" style="margin-top:10px;width:100%">Close</button>
</dialog>

</div>
<style>
@scope (#signature-day-store) {

#signature-day-store{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:#191919;background:#f5f5f5}*{box-sizing:border-box}
.editor[hidden],.product-intro[hidden]{display:none}.product-intro{max-width:1160px;margin:28px auto;padding:24px;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:32px;align-items:center;background:#fff;border:1px solid #e5e5e5;border-radius:18px}.product-photo{background:#f2efec;border-radius:14px;padding:16px}.product-photo img{display:block;width:100%;height:auto;object-fit:contain;background:#fff}.product-details h1{font-size:clamp(1.6rem,3vw,2.4rem);line-height:1.2;margin:0 0 12px}.product-details p{color:#555}.product-offer{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:22px 0 12px}.product-offer strong{font-size:1.55rem;color:#a74200}.regular-price{text-decoration:line-through;color:#777}.product-offer>span:last-child{width:100%;color:#555}.product-tier{display:grid;gap:4px;padding:13px 0;border-top:1px solid #e6e6e6}.product-tier span{color:#555}.product-count{padding:10px 12px;background:#fff5eb;border-radius:8px}.customize-button{font-size:1.1rem;max-width:360px;padding:14px 20px}.back-to-product{margin:20px max(24px,calc((100vw - 1320px)/2)) 0}
.review-button{max-width:430px}.review-panel{max-width:920px;margin:20px auto;padding:24px;background:#fff;border:1px solid #ddd;border-radius:16px}.review-panel[hidden]{display:none}.review-panel h2{margin:0}.review-panel dl{display:grid;grid-template-columns:1fr auto;gap:10px;margin:16px 0 20px}.review-panel dt,.review-panel dd{margin:0;padding:8px 0;border-bottom:1px solid #eee}.review-panel dd{text-align:right;font-weight:650}.review-panel .review-total{font-size:1.2rem;color:#a74200;font-weight:750}.review-panel button{margin-top:6px}
header{background:#fff;border-bottom:1px solid #ddd;padding:16px max(20px,calc((100vw - 1320px)/2))}
header strong{font-size:1.25rem}header span{color:#666;margin-left:12px}
.sd-main{max-width:1320px;margin:auto;padding:24px;display:grid;grid-template-columns:340px minmax(0,1fr);gap:24px}
.panel,.stage{background:#fff;border:1px solid #ddd;border-radius:16px;padding:22px}.panel{align-self:start}
h1{font-size:1.35rem;margin:0 0 10px}p{line-height:1.5;color:#555;margin:8px 0 16px}
label{display:block;font-weight:650;margin:16px 0 7px}.presets{display:flex;gap:8px}
button{border:1px solid #d1d1d1;background:#fff;color:#222;border-radius:10px;padding:11px 14px;font:inherit;cursor:pointer}
button[aria-pressed=true],button:hover{border-color:#ed7100;background:#fff2e8}
.photo-input{display:block;width:100%;max-width:100%;font:inherit;color:#333;padding:9px;border:1px solid #ddd;border-radius:10px;background:#fff}
.photo-input::file-selector-button{background:#f47700;color:#fff;border:0;border-radius:8px;padding:12px 15px;font:inherit;font-weight:700;margin-right:10px}
.files-upload{margin-top:12px}
.reset-design{margin-top:12px;color:#9b3500;border-color:#e8bca7}
.next{display:block;width:100%;background:#f47700;color:#fff;border:0;font-weight:750;margin-top:12px}.next:hover{background:#d86100;color:#fff}
.status{min-height:1.4em;color:#60400d;font-size:.94rem}.preview-nav{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.roster{max-height:420px;overflow:auto;margin-top:15px}.person{display:grid;grid-template-columns:34px minmax(0,1fr) 51px 51px 66px;align-items:center;gap:4px;width:100%;text-align:left;margin:5px 0;padding:5px}
.person.active{border-color:#eb6c00;background:#fff0e3}.avatar{height:34px;width:34px;border-radius:6px;object-fit:cover;display:grid;place-items:center;color:#fff;font-weight:700}
.person select{width:65px;padding:5px;border:1px solid #ddd;border-radius:5px;background:white}.person button{padding:7px 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:.78rem}
.person.swapping,.person .swap-button[aria-pressed=true]{border-color:#ed7100;background:#fff0e3}.person .swap-button{color:#af5400;border-color:#ed7100}
.person .crop-button{padding:7px 3px;color:#af5400;border-color:#ed7100}.crop-dialog{max-width:min(94vw,440px);border:0;border-radius:16px;padding:20px;box-shadow:0 20px 80px #0006}.crop-dialog::backdrop{background:#0009}.crop-dialog h2{margin:0 0 8px;font-size:1.15rem}.crop-dialog canvas{display:block;width:min(100%,340px);height:auto;touch-action:none;background:#ddd;margin:12px auto;border-radius:8px}.crop-actions{display:flex;gap:8px;flex-wrap:wrap}.crop-actions button{flex:1}.crop-dialog input[type=range]{width:100%;accent-color:#f47700}
.back-config{margin:18px 0;padding:14px;border:1px solid #e5d2c4;border-radius:12px;background:#fffaf6}.back-config h3{margin:0 0 8px}.back-order-toggle{display:flex;align-items:center;gap:8px;margin:10px 0}.back-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.back-choices label{display:flex;align-items:center;gap:7px;margin:0;font-size:.9rem}.back-choices input,.back-order-toggle input{accent-color:#ed7100}.back-shared label{margin:12px 0}.back-shared input,.person-back input[type=text]{display:block;width:100%;min-width:0;margin-top:5px;padding:9px;border:1px solid #ccc;border-radius:7px;font:inherit}.back-help{font-size:.85rem;margin:10px 0 0}.back-validation{color:#a32300;font-weight:650}.person-back{grid-column:1/-1;display:grid;gap:7px;padding:8px 4px;border-top:1px solid #eee}.person-back .personal-field{display:block;margin:0}.side-tabs{display:flex;gap:8px;align-self:stretch}.side-tabs button{flex:1}.back-preview-note{margin:0;text-align:center;color:#555}.pricing{background:#fff5eb;border:1px solid #ffd3a9;border-radius:10px;padding:12px}.pricing strong{display:block;margin-bottom:6px}.pricing small{display:block;margin-top:6px;color:#555;line-height:1.4}.price-inline{align-self:stretch;padding:10px;border-radius:8px;background:#fff5eb;text-align:center;font-weight:650}
.back-shared label[hidden]{display:none}
.back-choices[hidden],.back-shared[hidden],.back-help[hidden],.back-validation[hidden]{display:none}
.saved-image{display:block;width:min(75vw,280px);max-height:55vh;object-fit:contain;margin:12px auto}.download-link{display:block;text-align:center;background:#f47700;color:#fff;border-radius:10px;padding:12px;text-decoration:none;font-weight:700}
.stage{display:flex;flex-direction:column;align-items:center;gap:13px}.stage[hidden]{display:none}.toolbar{width:100%;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.toolbar strong{font-size:1.1rem}.stage canvas{max-width:min(100%,640px);height:auto;box-shadow:0 8px 32px #0002;background:#fff}
.notice{font-size:.88rem;color:#666}.counts{background:#fff5eb;padding:10px;border-radius:8px;font-size:.9rem}
@media(max-width:850px){.product-intro{display:block;margin:12px;padding:14px}.product-photo{padding:8px}.product-details{padding:18px 4px 4px}.sd-main{display:block;padding:14px}.stage{margin-top:14px}.roster{max-height:250px}}

.sd-heading{max-width:1320px;margin:0 auto;padding:24px 24px 0;font-size:1.7rem}.sd-subheading{max-width:1320px;margin:0 auto;padding:0 24px;color:#555}
}
</style>
<script type="application/json" id="signatureDayVariants">{{ product.variants | json }}</script>
<script>
(()=>{const root=document.getElementById('signature-day-store');if(!root)return;

const canvas=root.querySelector('#preview'),ctx=canvas.getContext('2d');
const shirtImage=new Image();shirtImage.crossOrigin='anonymous';shirtImage.onload=()=>draw();shirtImage.src='https://cdn.shopify.com/s/files/1/0803/7931/4361/files/signature-day-white-shirt-mockup.png?v=1790180938';
const backImage=new Image();backImage.crossOrigin='anonymous';backImage.onload=()=>draw();backImage.src='https://cdn.shopify.com/s/files/1/0803/7931/4361/files/signature-day-white-shirt-back-mockup.png?v=1790234914';
const roster=root.querySelector('#roster'),counts=root.querySelector('#counts');
const colors=['#a33c36','#26829a','#a27631','#855c99','#468269','#244d9b','#ac5d83','#755731'];
let people=[],selected=0,hasUploaded=false,sideOrder=[],swapFrom=null,side='front',includeBack=false;
const backFields={college:false,name:false,roll:false,group:false,year:false},backValues={college:'',group:'',year:''};
function openEditor(open){root.querySelector('#productIntro').hidden=open;root.querySelector('#editor').hidden=!open;(open?root.querySelector('#editor'):root.querySelector('#productIntro')).scrollIntoView({behavior:'smooth',block:'start'})}
root.querySelector('#customizeNow').onclick=()=>openEditor(true);
root.querySelector('#backToProduct').onclick=()=>openEditor(false);
function sample(n){hasUploaded=false;people=Array.from({length:n},(_,i)=>({name:'Person '+String(i+1).padStart(2,'0'),size:'M',image:null,color:colors[i%colors.length],backName:'',roll:''}));sideOrder=people.map((_,i)=>i);swapFrom=null;selected=0;render()}
function renderPrice(){const units=hasUploaded?people.length:0,front=units>10?130:150,back=includeBack?30:0,total=units*(front+back);const summary=units?units+' shirts × (₹'+front+' front'+(back?' + ₹30 back':'')+') = ₹'+total.toLocaleString('en-IN'):'Upload photos to calculate the order price';root.querySelector('#priceSummary').textContent=summary;root.querySelector('#previewPrice').textContent=summary+(units?' · Regular front total ₹'+(units*250).toLocaleString('en-IN'):' · Sample preview');root.querySelector('#productCount').textContent=units?summary:'The order total is calculated from the number of photos you upload.'}
function cropSource(image,w,h,crop){const base=Math.max(w/image.width,h/image.height),zoom=crop?.zoom||1,sw=w/(base*zoom),sh=h/(base*zoom);const cx=Math.max(sw/2,Math.min(image.width-sw/2,(crop?.cx??.5)*image.width)),cy=Math.max(sh/2,Math.min(image.height-sh/2,(crop?.cy??.5)*image.height));return {sx:cx-sw/2,sy:cy-sh/2,sw,sh}}
function cover(image,x,y,w,h,crop,target=ctx){const c=cropSource(image,w,h,crop);target.drawImage(image,c.sx,c.sy,c.sw,c.sh,x,y,w,h)}
function tile(person,x,y,w,h){ctx.save();ctx.beginPath();ctx.rect(x,y,w,h);ctx.clip();if(person.image)cover(person.image,x,y,w,h,person.crop);else{ctx.fillStyle=person.color;ctx.fillRect(x,y,w,h);ctx.fillStyle='#fff';ctx.font='700 '+Math.round(Math.min(w,h)*.33)+'px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(person.name.match(/\d+/)?.[0]||'?',x+w/2,y+h/2)}ctx.restore();ctx.strokeStyle='#fff';ctx.lineWidth=5;ctx.strokeRect(x,y,w,h)}
function collageGrid(n){if(n<=20)return {cols:6,rows:6};if(n<=32)return {cols:6,rows:8};if(n<=48)return {cols:8,rows:8};if(n<=64)return {cols:8,rows:10};let cols=10,rows=10;while(cols*rows-16<n){if(rows/cols<1.2)rows+=2;else cols+=2}return {cols,rows}}
function cornerPhotoIndex(index,gapCount){const step=Math.max(1,Math.floor(people.length/gapCount));return sideOrder[(index*step+Math.floor(step/2))%people.length]}
function esc(text){return String(text).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function dimensionArrow(x1,y1,x2,y2,label,vertical=false){ctx.save();ctx.strokeStyle='#bb4d00';ctx.fillStyle='#bb4d00';ctx.lineWidth=4;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();const a=Math.atan2(y2-y1,x2-x1),head=13;for(const [px,py,angle] of [[x1,y1,a],[x2,y2,a+Math.PI]]){ctx.beginPath();ctx.moveTo(px,py);ctx.lineTo(px+head*Math.cos(angle+.55),py+head*Math.sin(angle+.55));ctx.lineTo(px+head*Math.cos(angle-.55),py+head*Math.sin(angle-.55));ctx.closePath();ctx.fill()}const mx=(x1+x2)/2,my=(y1+y2)/2;ctx.font='700 28px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';if(vertical){ctx.translate(mx+19,my);ctx.rotate(-Math.PI/2);ctx.fillStyle='#fff';ctx.fillRect(-83,-20,166,40);ctx.fillStyle='#a43d00';ctx.fillText(label,0,0)}else{ctx.fillStyle='#fff';ctx.fillRect(mx-80,my-20,160,40);ctx.fillStyle='#a43d00';ctx.fillText(label,mx,my)}ctx.restore()}
function drawBack(){ctx.clearRect(0,0,1200,1400);ctx.fillStyle='#e4e1dd';ctx.fillRect(0,0,1200,1400);if(backImage.complete&&backImage.naturalWidth)ctx.drawImage(backImage,30,92,1140,1092);else{ctx.fillStyle='#fff';ctx.fillRect(205,130,790,1045)}
 const person=people[selected],lines=[];if(includeBack){if(backFields.college&&backValues.college.trim())lines.push({text:backValues.college.trim(),size:32,weight:650});if(backFields.group&&backValues.group.trim())lines.push({text:backValues.group.trim(),size:42,weight:750});if(backFields.name&&person.backName?.trim())lines.push({text:person.backName.trim(),size:52,weight:750});if(backFields.roll&&person.roll?.trim())lines.push({text:'Roll No: '+person.roll.trim(),size:31,weight:600});if(backFields.year&&backValues.year.trim())lines.push({text:backValues.year.trim(),size:29,weight:600})}
 const note=root.querySelector('#backPreviewNote');note.hidden=false;note.textContent=lines.length?'Back print for '+person.name+'. Only the selected details with text are shown.':'Blank back for '+(person?.name||'this shirt')+'.';
 let y=470;for(const line of lines){let size=line.size;ctx.font=line.weight+' '+size+'px system-ui';while(ctx.measureText(line.text).width>455&&size>20){size-=2;ctx.font=line.weight+' '+size+'px system-ui'}ctx.fillStyle='#171717';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(line.text,600,y,455);y+=Math.max(60,size+19)}
 ctx.fillStyle='#4b4b4b';ctx.font='600 25px system-ui';ctx.textAlign='center';ctx.fillText((person?.name||'')+' · back · size '+(person?.size||'M'),600,1260)}
function draw(){root.querySelector('#frontView').setAttribute('aria-pressed',side==='front');root.querySelector('#backView').setAttribute('aria-pressed',side==='back');root.querySelector('#cropCenter').hidden=side==='back';if(side==='back'){drawBack();return}root.querySelector('#backPreviewNote').hidden=true;const W=1200,H=1400;ctx.clearRect(0,0,W,H);ctx.fillStyle='#e4e1dd';ctx.fillRect(0,0,W,H);
 // Keep the A4 artwork within the real shirt, with visible fabric on all four sides.
 if(shirtImage.complete&&shirtImage.naturalWidth){ctx.drawImage(shirtImage,30,92,1140,1092)}else{ctx.fillStyle='#fff';ctx.fillRect(205,130,790,1045)}
 const n=people.length,{cols,rows}=collageGrid(n),center=4,w=390,h=552,x=405,y=395,cellW=w/cols,cellH=h/rows;
 const centerCol=(cols-center)/2,centerRow=(rows-center)/2,slots=[];
 ctx.fillStyle='#fff';ctx.fillRect(x,y,w,h);
 for(let row=0;row<rows;row++)for(let col=0;col<cols;col++){
  if(row>=centerRow&&row<centerRow+center&&col>=centerCol&&col<centerCol+center)continue;
  slots.push({row,col,x:x+col*cellW,y:y+row*cellH});
 }
 // Use equal aspect ratios. Repeat surrounding portraits in spare corner cells so the print has no blank tiles.
 const cornerDistance=slot=>Math.min(slot.row,rows-1-slot.row)**2+Math.min(slot.col,cols-1-slot.col)**2;
 const gaps=new Set([...slots].sort((a,b)=>cornerDistance(a)-cornerDistance(b)).slice(0,slots.length-n));
 const filled=slots.filter(slot=>!gaps.has(slot));
 sideOrder.forEach((personIndex,i)=>{const slot=filled[i];tile(people[personIndex],slot.x,slot.y,cellW,cellH)});
 [...gaps].forEach((slot,i)=>tile(people[cornerPhotoIndex(i,gaps.size)],slot.x,slot.y,cellW,cellH));
 const focus=people[selected],focusX=x+centerCol*cellW,focusY=y+centerRow*cellH;
