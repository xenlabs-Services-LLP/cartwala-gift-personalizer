<script>
(()=>{const root=document.getElementById('signature-day-store');if(!root)return;

const canvas=root.querySelector('#preview'),ctx=canvas.getContext('2d');
const shirtImage=new Image();shirtImage.crossOrigin='anonymous';shirtImage.onload=()=>draw();shirtImage.src='https://cdn.shopify.com/s/files/1/0803/7931/4361/files/signature-day-white-shirt-mockup.png?v=1790180938';
const backImage=new Image();backImage.crossOrigin='anonymous';backImage.onload=()=>draw();backImage.src='https://cdn.shopify.com/s/files/1/0803/7931/4361/files/signature-day-white-shirt-back-mockup.png?v=1790234914';
const roster=root.querySelector('#roster'),counts=root.querySelector('#counts');
const colors=['#a33c36','#26829a','#a27631','#855c99','#468269','#244d9b','#ac5d83','#755731'];
let people=[],selected=0,hasUploaded=false,sideOrder=[],swapFrom=null,side='front',includeBack=false;
const backFields={college:false,name:false,roll:false,group:false,year:false},backValues={college:'',group:'',year:''};let backTemplate='crest';
function openEditor(open){root.querySelector('#productIntro').hidden=open;root.querySelector('#productExtras').hidden=open;root.querySelector('#productDescription').hidden=open;root.querySelector('#editor').hidden=!open;(open?root.querySelector('#editor'):root.querySelector('#productIntro')).scrollIntoView({behavior:'smooth',block:'start'})}
root.querySelectorAll('.signature-product-thumb').forEach(button=>button.addEventListener('click',()=>{const photo=root.querySelector('#signatureProductImage');photo.src=button.dataset.gallerySrc;photo.alt=button.dataset.galleryAlt;root.querySelectorAll('.signature-product-thumb').forEach(item=>item.setAttribute('aria-pressed',String(item===button)))}));
const dateBase=new Date();const calendarDay=new Date(Date.UTC(dateBase.getFullYear(),dateBase.getMonth(),dateBase.getDate()));
function dateAt(offset){const day=new Date(calendarDay);day.setUTCDate(day.getUTCDate()+offset);return day}
function dateText(day){return day.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'})}
function dateRange(from,to){const a=dateAt(from),b=dateAt(to),month=a.toLocaleDateString('en-IN',{month:'long',timeZone:'UTC'});return a.getUTCMonth()===b.getUTCMonth()&&a.getUTCFullYear()===b.getUTCFullYear()?a.getUTCDate()+'–'+b.getUTCDate()+' '+month+' '+a.getUTCFullYear():dateText(a)+' – '+dateText(b)}
root.querySelector('#signatureOrdered').textContent=calendarDay.toLocaleDateString('en-IN',{day:'numeric',month:'short',timeZone:'UTC'});
root.querySelector('#signatureOrdered').dateTime=calendarDay.toISOString().slice(0,10);
root.querySelector('#signatureReady').textContent=dateRange(2,3);
root.querySelector('#signatureDelivered').textContent=dateRange(7,9);
const informationTabs=[['signatureDescriptionTab','signatureDescriptionPanel'],['signatureShippingTab','signatureShippingPanel']];
informationTabs.forEach(([tabId,panelId])=>root.querySelector('#'+tabId).addEventListener('click',()=>informationTabs.forEach(([id,sectionId])=>{const selected=id===tabId;root.querySelector('#'+id).setAttribute('aria-selected',String(selected));root.querySelector('#'+sectionId).hidden=!selected})));
root.querySelector('#customizeNow').onclick=()=>openEditor(true);
root.querySelector('#backToProduct').onclick=()=>openEditor(false);
function sample(n){hasUploaded=false;people=Array.from({length:n},(_,i)=>({name:'Person '+String(i+1).padStart(2,'0'),size:'M',image:null,color:colors[i%colors.length],backName:'',roll:''}));sideOrder=people.map((_,i)=>i);swapFrom=null;selected=0;render()}
function renderPrice(){const units=hasUploaded?people.length:0,front=units>10?130:150,back=includeBack?30:0,total=units*(front+back);const summary=units?units+' shirts × (₹'+front+' front'+(back?' + ₹30 back':'')+') = ₹'+total.toLocaleString('en-IN'):'Upload photos to calculate the order price';root.querySelector('#priceSummary').textContent=summary;root.querySelector('#previewPrice').textContent=summary+(units?' · Regular front total ₹'+(units*250).toLocaleString('en-IN'):' · Sample preview');root.querySelector('#productCount').textContent=units?summary:'The order total is calculated from the number of photos you upload.'}
function cropSource(image,w,h,crop){const base=Math.max(w/image.width,h/image.height),zoom=crop?.zoom||1,sw=w/(base*zoom),sh=h/(base*zoom);const cx=Math.max(sw/2,Math.min(image.width-sw/2,(crop?.cx??.5)*image.width)),cy=Math.max(sh/2,Math.min(image.height-sh/2,(crop?.cy??.5)*image.height));return {sx:cx-sw/2,sy:cy-sh/2,sw,sh}}
function cover(image,x,y,w,h,crop,target=ctx){const c=cropSource(image,w,h,crop);target.drawImage(image,c.sx,c.sy,c.sw,c.sh,x,y,w,h)}
function tile(person,x,y,w,h){ctx.save();ctx.beginPath();ctx.rect(x,y,w,h);ctx.clip();if(person.image)cover(person.image,x,y,w,h,person.crop);else{ctx.fillStyle=person.color;ctx.fillRect(x,y,w,h);ctx.fillStyle='#fff';ctx.font='700 '+Math.round(Math.min(w,h)*.33)+'px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(person.name.match(/\d+/)?.[0]||'?',x+w/2,y+h/2)}ctx.restore();ctx.strokeStyle='#fff';ctx.lineWidth=5;ctx.strokeRect(x,y,w,h)}
function collageGrid(n){if(n<=20)return {cols:6,rows:6};if(n<=32)return {cols:6,rows:8};if(n<=48)return {cols:8,rows:8};if(n<=64)return {cols:8,rows:10};let cols=10,rows=10;while(cols*rows-16<n){if(rows/cols<1.2)rows+=2;else cols+=2}return {cols,rows}}
function cornerPhotoIndex(index,gapCount){const step=Math.max(1,Math.floor(people.length/gapCount));return sideOrder[(index*step+Math.floor(step/2))%people.length]}
function esc(text){return String(text).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function dimensionArrow(x1,y1,x2,y2,label,vertical=false){ctx.save();ctx.strokeStyle='#bb4d00';ctx.fillStyle='#bb4d00';ctx.lineWidth=4;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();const a=Math.atan2(y2-y1,x2-x1),head=13;for(const [px,py,angle] of [[x1,y1,a],[x2,y2,a+Math.PI]]){ctx.beginPath();ctx.moveTo(px,py);ctx.lineTo(px+head*Math.cos(angle+.55),py+head*Math.sin(angle+.55));ctx.lineTo(px+head*Math.cos(angle-.55),py+head*Math.sin(angle-.55));ctx.closePath();ctx.fill()}const mx=(x1+x2)/2,my=(y1+y2)/2;ctx.font='700 28px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';if(vertical){ctx.translate(mx+19,my);ctx.rotate(-Math.PI/2);ctx.fillStyle='#fff';ctx.fillRect(-83,-20,166,40);ctx.fillStyle='#a43d00';ctx.fillText(label,0,0)}else{ctx.fillStyle='#fff';ctx.fillRect(mx-80,my-20,160,40);ctx.fillStyle='#a43d00';ctx.fillText(label,mx,my)}ctx.restore()}
function backDetailLines(person){return [['college',backValues.college],['name',person?.backName],['roll',person?.roll?'Roll No: '+person.roll:''],['group',backValues.group],['year',backValues.year]].filter(([key,value])=>backFields[key]&&String(value||'').trim()).map(([key,value])=>({key,text:String(value).trim()}))}
function drawBackArtwork(target,index){const W=2480,H=3508,person=people[index],lines=backDetailLines(person),accent=backTemplate==='ribbon'?'#b64a13':backTemplate==='minimal'?'#285963':'#a14319';target.save();target.fillStyle='#fff';target.fillRect(0,0,W,H);if(!lines.length){target.restore();return}
 target.strokeStyle=accent;target.fillStyle=accent;
 if(backTemplate==='crest'){
  target.lineWidth=19;target.strokeRect(170,185,W-340,H-370);target.lineWidth=7;target.strokeRect(217,232,W-434,H-464);
  target.beginPath();target.arc(W/2,720,220,0,Math.PI*2);target.stroke();target.font='700 235px Georgia,serif';target.textAlign='center';target.textBaseline='middle';target.fillText('SD',W/2,720);target.fillRect(640,1030,1200,12);
 }else if(backTemplate==='ribbon'){
  target.fillRect(150,250,W-300,210);target.fillStyle='#fff';target.font='700 113px system-ui';target.textAlign='center';target.textBaseline='middle';target.fillText('SIGNATURE DAY',W/2,355);target.fillStyle=accent;
  target.beginPath();target.moveTo(W/2,610);target.lineTo(W/2+160,760);target.lineTo(W/2,910);target.lineTo(W/2-160,760);target.closePath();target.stroke();target.fillRect(430,3070,W-860,12);
 }else{
  target.lineWidth=16;target.beginPath();target.moveTo(250,280);target.lineTo(880,280);target.moveTo(1600,280);target.lineTo(2230,280);target.stroke();target.font='700 160px system-ui';target.textAlign='center';target.textBaseline='middle';target.fillText('✦',W/2,300);target.fillRect(250,3160,W-500,16);
 }
 const positions=backTemplate==='crest'?[1470,2060,2650]:[1340,1940,2540];lines.slice(0,3).forEach((line,i)=>{
  const maxWidth=1850,words=line.text.split(/\s+/),parts=[''];let fontSize=i===1?220:178;
  target.font=(i===1?'750 ':'650 ')+fontSize+'px system-ui';for(const word of words){const current=parts[parts.length-1];if(current&&target.measureText(current+' '+word).width>maxWidth&&parts.length<2)parts.push(word);else parts[parts.length-1]=current?current+' '+word:word}
  if(parts.length===2)fontSize=Math.min(fontSize,170);while(parts.some(part=>{target.font=(i===1?'750 ':'650 ')+fontSize+'px system-ui';return target.measureText(part).width>maxWidth})&&fontSize>95)fontSize-=5;
  const y=positions[i];target.textAlign='center';target.textBaseline='middle';target.fillStyle=i===1?accent:'#212121';parts.forEach((part,j)=>target.fillText(part,W/2,y+(j-(parts.length-1)/2)*fontSize*1.3,maxWidth));
  if(i<2){target.fillStyle=accent;target.fillRect(840,y+335,800,7)}
 });target.restore()}
function drawBack(){ctx.clearRect(0,0,1200,1400);ctx.fillStyle='#e4e1dd';ctx.fillRect(0,0,1200,1400);if(backImage.complete&&backImage.naturalWidth)ctx.drawImage(backImage,30,92,1140,1092);else{ctx.fillStyle='#fff';ctx.fillRect(205,130,790,1045)}
 const person=people[selected],lines=includeBack?backDetailLines(person):[];const note=root.querySelector('#backPreviewNote');note.hidden=false;note.textContent=lines.length?'A4 back design for '+person.name+'. Template: '+backTemplate+'.':'Blank back for '+(person?.name||'this shirt')+'.';
 if(lines.length){const artwork=document.createElement('canvas');artwork.width=620;artwork.height=877;const previewContext=artwork.getContext('2d');previewContext.scale(.25,.25);drawBackArtwork(previewContext,selected);ctx.drawImage(artwork,405,395,390,552)}ctx.fillStyle='#4b4b4b';ctx.font='600 25px system-ui';ctx.textAlign='center';ctx.fillText((person?.name||'')+' · back · size '+(person?.size||'M'),600,1260)}
function draw(){root.querySelector('#frontView').setAttribute('aria-pressed',side==='front');root.querySelector('#backView').setAttribute('aria-pressed',side==='back');root.querySelector('#cropCenter').hidden=side==='back';if(side==='back'){drawBack();return}root.querySelector('#backPreviewNote').hidden=true;const W=1200,H=1400;ctx.clearRect(0,0,W,H);ctx.fillStyle='#e4e1dd';ctx.fillRect(0,0,W,H);
 // Keep the A4 artwork within the real shirt, with visible fabric on all four sides.
 if(shirtImage.complete&&shirtImage.naturalWidth){ctx.drawImage(shirtImage,30,92,1140,1092)}else{ctx.fillStyle='#fff';ctx.fillRect(205,130,790,1045)}
 const n=people.length,{cols,rows}=collageGrid(n),center=4,w=390,h=552,x=405,y=395,cellW=w/cols,cellH=h/rows;
 const centerCol=(cols-center)/2,centerRow=(rows-center)/2,slots=[];
 ctx.fillStyle='#fff';ctx.fillRect(x,y,w,h);
 for(let row=0;row<rows;row++)for(let col=0;col<cols;col++){
  if(row>=centerRow&&row<centerRow+center&&col>=centerCol&&col<centerCol+center)continue;
  slots.push({row,col,x:x+col*cellW,y:y+row*cellH});
 }
 // Use equal aspect ratios. Repeat surrounding portraits in spare corner cells so the print has no blank tiles.
 const cornerDistance=slot=>Math.min(slot.row,rows-1-slot.row)**2+Math.min(slot.col,cols-1-slot.col)**2;
 const gaps=new Set([...slots].sort((a,b)=>cornerDistance(a)-cornerDistance(b)).slice(0,slots.length-n));
 const filled=slots.filter(slot=>!gaps.has(slot));
 sideOrder.forEach((personIndex,i)=>{const slot=filled[i];tile(people[personIndex],slot.x,slot.y,cellW,cellH)});
 [...gaps].forEach((slot,i)=>tile(people[cornerPhotoIndex(i,gaps.size)],slot.x,slot.y,cellW,cellH));
 const focus=people[selected],focusX=x+centerCol*cellW,focusY=y+centerRow*cellH;
 ctx.fillStyle='#fff';ctx.fillRect(focusX,focusY,center*cellW,center*cellH);
 if(focus)tile(focus,focusX,focusY,center*cellW,center*cellH);
 ctx.strokeStyle='#ddd';ctx.lineWidth=2;ctx.strokeRect(x,y,w,h);
 dimensionArrow(x,y-27,x+w,y-27,'8.27 in');dimensionArrow(x+w+35,y,x+w+35,y+h,'11.69 in',true);
 ctx.font='600 25px system-ui';ctx.textAlign='center';ctx.fillStyle='#4b4b4b';ctx.fillText((focus?.name||'')+' · '+n+' photos · size '+(focus?.size||'M'),600,1260);
 }
function swapPhoto(i){if(swapFrom===null){swapFrom=i;render();status.textContent='Choose another photo’s Swap button to exchange its position with '+people[i].name+'. Tap the same button to cancel.';return}if(swapFrom===i){swapFrom=null;render();status.textContent='Swap cancelled.';return}const from=swapFrom,a=sideOrder.indexOf(from),b=sideOrder.indexOf(i);[sideOrder[a],sideOrder[b]]=[sideOrder[b],sideOrder[a]];swapFrom=null;render();status.textContent=people[from].name+' and '+people[i].name+' swapped in the collage.';saveDraft().catch(()=>{status.textContent+=' Save a PNG before closing; browser draft storage failed.'})}
function render(){root.querySelector('#p15').setAttribute('aria-pressed',!hasUploaded&&people.length===15);root.querySelector('#p30').setAttribute('aria-pressed',!hasUploaded&&people.length===30);counts.textContent=people.length+(hasUploaded?' uploaded photos → ':' sample portraits → ')+people.length+' unique center-photo designs';root.querySelector('#previewTitle').textContent=(people[selected]?.name||'')+' — shirt '+(selected+1)+' of '+people.length;
 roster.replaceChildren();people.forEach((p,i)=>{
  const row=document.createElement('div');row.className='person'+(i===selected?' active':'')+(i===swapFrom?' swapping':'');const portrait=p.image?'<img class="avatar" src="'+p.image.src+'" alt="">':'<span class="avatar" style="background:'+p.color+'">'+(i+1)+'</span>';
  row.innerHTML=portrait+'<button type="button" aria-label="Preview '+esc(p.name)+'">'+esc(p.name)+'</button><button class="crop-button" type="button" '+(p.image?'':'disabled')+' aria-label="Crop '+esc(p.name)+'">Crop</button><button class="swap-button" type="button" aria-pressed="'+(i===swapFrom)+'" aria-label="Swap '+esc(p.name)+'">Swap</button><select aria-label="Size for '+esc(p.name)+'"><option>XS</option><option>S</option><option>M</option><option>L</option><option>XL</option><option>XXL</option></select>';
  row.querySelector('button').addEventListener('click',()=>{selected=i;render()});row.querySelector('.crop-button').addEventListener('click',()=>openCrop(i));row.querySelector('.swap-button').addEventListener('click',()=>swapPhoto(i));row.querySelector('select').value=p.size;row.querySelector('select').addEventListener('change',e=>{p.size=e.target.value;draw();saveDraft().catch(()=>{status.textContent='Size changed, but browser draft storage failed. Save a PNG before closing.'})});
  if(includeBack&&(backFields.name||backFields.roll)){
   const personal=document.createElement('div');personal.className='person-back';personal.innerHTML=(backFields.name?'<label class="personal-field">Student name<input type="text" class="back-name" maxlength="50" placeholder="Name for '+esc(p.name)+'" value="'+esc(p.backName||'')+'"></label>':'')+(backFields.roll?'<label class="personal-field">Roll number<input type="text" class="back-roll" maxlength="30" placeholder="Roll number for '+esc(p.name)+'" value="'+esc(p.roll||'')+'"></label>':'');
   if(backFields.name)personal.querySelector('.back-name').addEventListener('input',e=>{p.backName=e.target.value;draw();saveDraft().catch(()=>{})});
   if(backFields.roll)personal.querySelector('.back-roll').addEventListener('input',e=>{p.roll=e.target.value;draw();saveDraft().catch(()=>{})});
   row.append(personal)
  }
  roster.append(row)
 });renderPrice();draw()}
root.querySelector('#p15').onclick=()=>sample(15);root.querySelector('#p30').onclick=()=>sample(30);
const status=root.querySelector('#uploadStatus');
function updateBackControls(){root.querySelector('#includeBack').checked=includeBack;root.querySelector('#backChoices').hidden=!includeBack;root.querySelector('#backShared').hidden=!includeBack;root.querySelector('#backHelp').hidden=!includeBack;root.querySelector('#backTemplates').hidden=!includeBack;root.querySelector('#backFieldCount').hidden=!includeBack;root.querySelector('#backFieldCount').textContent='Choose any 3 details ('+Object.values(backFields).filter(Boolean).length+' of 3 selected).';root.querySelectorAll('[data-back-field]').forEach(input=>input.checked=backFields[input.dataset.backField]);root.querySelectorAll('[data-shared]').forEach(label=>label.hidden=!backFields[label.dataset.shared]);root.querySelectorAll('[data-back-value]').forEach(input=>input.value=backValues[input.dataset.backValue]);root.querySelectorAll('[name="signatureBackTemplate"]').forEach(input=>input.checked=input.value===backTemplate);render()}
root.querySelector('#includeBack').addEventListener('change',e=>{includeBack=e.target.checked;root.querySelector('#backValidation').hidden=true;updateBackControls();saveDraft().catch(()=>{})});
root.querySelectorAll('[data-back-field]').forEach(input=>input.addEventListener('change',()=>{if(input.checked&&Object.values(backFields).filter(Boolean).length>=3){input.checked=false;const alert=root.querySelector('#backValidation');alert.textContent='Choose only 3 back details. Deselect one before selecting another.';alert.hidden=false;return}backFields[input.dataset.backField]=input.checked;root.querySelector('#backValidation').hidden=true;updateBackControls();saveDraft().catch(()=>{})}));
root.querySelectorAll('[name="signatureBackTemplate"]').forEach(input=>input.addEventListener('change',()=>{if(!input.checked)return;backTemplate=input.value;draw();saveDraft().catch(()=>{})}));
root.querySelectorAll('[data-back-value]').forEach(input=>input.addEventListener('input',()=>{backValues[input.dataset.backValue]=input.value;draw();saveDraft().catch(()=>{})}));
root.querySelector('#frontView').onclick=()=>{side='front';draw()};root.querySelector('#backView').onclick=()=>{side='back';draw()};
function openDraftDB(){return new Promise((resolve,reject)=>{const req=indexedDB.open('cartwala-signature-store-preview',2);req.onupgradeneeded=()=>{if(!req.result.objectStoreNames.contains('drafts'))req.result.createObjectStore('drafts',{keyPath:'id'});if(!req.result.objectStoreNames.contains('originals'))req.result.createObjectStore('originals')};req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error)})}
let printCache=null;
function updateConfirmButton(){root.querySelector('#confirmOrder').textContent='Add T-shirts to cart'}
async function saveOriginals(persons){const entries=persons.filter(p=>p.photoKey&&p.sourceFile);if(!entries.length)return;const db=await openDraftDB();try{await new Promise((resolve,reject)=>{const tx=db.transaction('originals','readwrite');for(const person of entries)tx.objectStore('originals').put(person.sourceFile,person.photoKey);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error);tx.onabort=()=>reject(tx.error)})}finally{db.close()}}
async function savedOriginal(db,key){if(!key)return null;return new Promise((resolve,reject)=>{const request=db.transaction('originals').objectStore('originals').get(key);request.onsuccess=()=>resolve(request.result||null);request.onerror=()=>reject(request.error)})}
async function saveDraft(){if(!hasUploaded)return;const db=await openDraftDB();const snapshot={id:'current',people:people.map(p=>({name:p.name,size:p.size,color:p.color,crop:p.crop,blob:p.blob,photoKey:p.photoKey,sourceUrl:p.sourceUrl,backName:p.backName,roll:p.roll})),sideOrder,includeBack,backFields:{...backFields},backValues:{...backValues},backTemplate,printCache};await new Promise((resolve,reject)=>{const tx=db.transaction('drafts','readwrite');tx.objectStore('drafts').put(snapshot);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error);tx.onabort=()=>reject(tx.error)});db.close()}
root.querySelector('#resetDesign').onclick=async()=>{if(hasUploaded&&!window.confirm('Remove all uploaded photos, back details and saved design from this browser?'))return;for(const person of people){if(person.image?.src?.startsWith('blob:'))URL.revokeObjectURL(person.image.src)}hasUploaded=false;includeBack=false;backTemplate='crest';printCache=null;side='front';for(const key of Object.keys(backFields))backFields[key]=false;for(const key of Object.keys(backValues))backValues[key]='';root.querySelector('#files').value='';root.querySelector('#previews').hidden=true;root.querySelector('#orderReview').hidden=true;sample(15);updateBackControls();try{const db=await openDraftDB();await new Promise((resolve,reject)=>{const tx=db.transaction(['drafts','originals'],'readwrite');tx.objectStore('drafts').delete('current');tx.objectStore('originals').clear();tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)});db.close();status.textContent='Design reset. Choose your photos to start again.'}catch(_){status.textContent='Design reset on this page. This browser could not clear its saved draft.'}updateConfirmButton();root.querySelector('#files').scrollIntoView({behavior:'smooth',block:'center'})};
