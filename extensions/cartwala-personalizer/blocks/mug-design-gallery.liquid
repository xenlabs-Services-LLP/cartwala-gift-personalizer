{% liquid
  assign active_model = ''
  assign model_tag = ''
  assign model_title = ''
  if current_tags contains 'cw-mug-model-white'
    assign active_model = 'white'
    assign model_tag = 'cw-mug-model-white'
    assign model_title = 'mug_gallery.normal_mugs' | t
  elsif current_tags contains 'cw-mug-model-magic'
    assign active_model = 'magic'
    assign model_tag = 'cw-mug-model-magic'
    assign model_title = 'mug_gallery.magic_mugs' | t
  elsif current_tags contains 'cw-mug-model-love-handle'
    assign active_model = 'love_handle'
    assign model_tag = 'cw-mug-model-love-handle'
    assign model_title = 'mug_gallery.love_handle_mugs' | t
  elsif current_tags contains 'cw-mug-model-red'
    assign active_model = 'inner_red'
    assign model_tag = 'cw-mug-model-red'
    assign model_title = 'mug_gallery.inner_red_mugs' | t
  endif

  assign active_category = 'all'
  if current_tags contains 'cw-mug-birthday'
    assign active_category = 'birthday'
  elsif current_tags contains 'cw-mug-anniversary'
    assign active_category = 'anniversary'
  elsif current_tags contains 'cw-mug-love'
    assign active_category = 'love'
  elsif current_tags contains 'cw-mug-family'
    assign active_category = 'family'
  elsif current_tags contains 'cw-mug-friends'
    assign active_category = 'friends'
  elsif current_tags contains 'cw-mug-other'
    assign active_category = 'other'
  endif

  assign normal_mug_alt = 'mug_gallery.normal_mugs' | t
  assign magic_mug_alt = 'mug_gallery.magic_mugs' | t
  assign love_handle_mug_alt = 'mug_gallery.love_handle_mugs' | t
  assign inner_red_mug_alt = 'mug_gallery.inner_red_mugs' | t
%}

{{ 'cartwala-mug-gallery.css' | asset_url | stylesheet_tag }}

<section class="cw-mug-gallery" style="--cw-mug-gallery-accent: {{ block.settings.accent_color }}" {{ block.shopify_attributes }}>
  <header class="cw-mug-gallery__header">
    <p class="cw-mug-gallery__eyebrow">{{ 'mug_gallery.eyebrow' | t }}</p>
    {% if active_model == blank %}
      <h1>{{ collection.title | escape }}</h1>
      <p>{{ 'mug_gallery.choose_mug_type' | t }}</p>
    {% else %}
      <a class="cw-mug-gallery__back" href="{{ collection.url }}">← {{ 'mug_gallery.all_mug_types' | t }}</a>
      <h1>{{ model_title | escape }}</h1>
      <p>{{ 'mug_gallery.choose_design' | t: mug_type: model_title }}</p>
    {% endif %}
    <ol class="cw-mug-gallery__steps" aria-label="{{ 'mug_gallery.steps_label' | t | escape }}">
      <li><span>1</span>{{ 'mug_gallery.select_mug' | t }}</li>
      <li><span>2</span>{{ 'mug_gallery.select_design' | t }}</li>
      <li><span>3</span>{{ 'mug_gallery.preview_buy' | t }}</li>
    </ol>
  </header>

  {% if active_model == blank %}
    <div class="cw-mug-types" aria-label="{{ 'mug_gallery.mug_types_label' | t | escape }}">
      <a class="cw-mug-type-card" href="{{ collection.url }}/cw-mug-model-white">
        <div class="cw-mug-type-card__image">
          <img src="{{ 'cartwala-mug-normal.jpg' | asset_url }}" alt="{{ normal_mug_alt | escape }}" width="1254" height="1254" loading="eager">
        </div>
        <div class="cw-mug-type-card__content"><h2>{{ 'mug_gallery.normal_mugs' | t }}</h2><p><s>{{ 45000 | money }}</s><strong>{{ 25000 | money }}</strong></p><span>{{ 'mug_gallery.view_designs' | t }} →</span></div>
      </a>
      <a class="cw-mug-type-card cw-mug-type-card--magic" href="{{ collection.url }}/cw-mug-model-magic">
        <div class="cw-mug-type-card__image">
          <img src="{{ 'cartwala-mug-magic.jpg' | asset_url }}" alt="{{ magic_mug_alt | escape }}" width="1254" height="1254" loading="eager">
          <span class="cw-mug-type-card__effect">{{ 'mug_gallery.hot_water_reveal' | t }}</span>
        </div>
        <div class="cw-mug-type-card__content"><h2>{{ 'mug_gallery.magic_mugs' | t }}</h2><p><s>{{ 80000 | money }}</s><strong>{{ 40000 | money }}</strong></p><span>{{ 'mug_gallery.view_designs' | t }} →</span></div>
      </a>
      <a class="cw-mug-type-card" href="{{ collection.url }}/cw-mug-model-love-handle">
        <div class="cw-mug-type-card__image">
          <img src="{{ 'cartwala-mug-love-handle.jpg' | asset_url }}" alt="{{ love_handle_mug_alt | escape }}" width="1254" height="1254" loading="lazy">
        </div>
        <div class="cw-mug-type-card__content"><h2>{{ 'mug_gallery.love_handle_mugs' | t }}</h2><p><s>{{ 70000 | money }}</s><strong>{{ 30000 | money }}</strong></p><span>{{ 'mug_gallery.view_designs' | t }} →</span></div>
      </a>
      <a class="cw-mug-type-card" href="{{ collection.url }}/cw-mug-model-red">
        <div class="cw-mug-type-card__image">
          <img src="{{ 'cartwala-mug-inner-red.jpg' | asset_url }}" alt="{{ inner_red_mug_alt | escape }}" width="1254" height="1254" loading="lazy">
        </div>
        <div class="cw-mug-type-card__content"><h2>{{ 'mug_gallery.inner_red_mugs' | t }}</h2><p><s>{{ 70000 | money }}</s><strong>{{ 30000 | money }}</strong></p><span>{{ 'mug_gallery.view_designs' | t }} →</span></div>
      </a>
    </div>
  {% else %}
    <nav class="cw-mug-gallery__filters" aria-label="{{ 'mug_gallery.filters_label' | t | escape }}">
      <a href="{{ collection.url }}/{{ model_tag }}"{% if active_category == 'all' %} class="is-active" aria-current="page"{% endif %}>{{ 'mug_gallery.all' | t }}</a>
      <a href="{{ collection.url }}/{{ model_tag }}+cw-mug-birthday"{% if active_category == 'birthday' %} class="is-active" aria-current="page"{% endif %}>{{ 'mug_gallery.birthday' | t }}</a>
      <a href="{{ collection.url }}/{{ model_tag }}+cw-mug-anniversary"{% if active_category == 'anniversary' %} class="is-active" aria-current="page"{% endif %}>{{ 'mug_gallery.anniversary' | t }}</a>
      <a href="{{ collection.url }}/{{ model_tag }}+cw-mug-love"{% if active_category == 'love' %} class="is-active" aria-current="page"{% endif %}>{{ 'mug_gallery.love' | t }}</a>
      <a href="{{ collection.url }}/{{ model_tag }}+cw-mug-family"{% if active_category == 'family' %} class="is-active" aria-current="page"{% endif %}>{{ 'mug_gallery.family' | t }}</a>
      <a href="{{ collection.url }}/{{ model_tag }}+cw-mug-friends"{% if active_category == 'friends' %} class="is-active" aria-current="page"{% endif %}>{{ 'mug_gallery.friends' | t }}</a>
      <a href="{{ collection.url }}/{{ model_tag }}+cw-mug-other"{% if active_category == 'other' %} class="is-active" aria-current="page"{% endif %}>{{ 'mug_gallery.other' | t }}</a>
    </nav>

    {% paginate collection.products by block.settings.products_per_page %}
      {% if collection.products_count > 0 %}
        <div class="cw-mug-gallery__grid">
          {% for product in collection.products %}
            <article class="cw-mug-card">
              <a class="cw-mug-card__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240,360,540,720,900', sizes: '(min-width: 990px) 25vw, (min-width: 600px) 33vw, 50vw', alt: product.featured_image.alt | default: product.title }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'cw-mug-card__placeholder' }}
                {% endif %}
                {% if product.compare_at_price_max > product.price %}<span class="cw-mug-card__sale">{{ 'mug_gallery.sale' | t }}</span>{% endif %}
              </a>
              <div class="cw-mug-card__content">
                <h2><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
                <p class="cw-mug-card__price"><strong>{{ product.price | money }}</strong>{% if product.compare_at_price_max > product.price %}<s>{{ product.compare_at_price_max | money }}</s>{% endif %}</p>
                <a class="cw-mug-card__start" href="{{ product.url }}">{{ 'mug_gallery.start_design' | t }}</a>
              </div>
            </article>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}<div class="cw-mug-gallery__pagination">{{ paginate | default_pagination }}</div>{% endif %}
      {% else %}
        <div class="cw-mug-gallery__empty"><h2>{{ 'mug_gallery.empty_title' | t }}</h2><p>{{ 'mug_gallery.empty_text' | t }}</p></div>
      {% endif %}
    {% endpaginate %}
  {% endif %}
</section>

{% schema %}
{"name":"t:mug_gallery.block_name","target":"section","enabled_on":{"templates":["collection"]},"settings":[{"type":"inline_richtext","id":"intro","label":"t:mug_gallery.intro","default":"Choose a mug type, select a design, upload your photo and preview your personalised mug."},{"type":"color","id":"accent_color","label":"t:mug_gallery.accent_color","default":"#ff6200"},{"type":"image_picker","id":"normal_mug_image","label":"t:mug_gallery.normal_mug_image"},{"type":"image_picker","id":"magic_mug_image","label":"t:mug_gallery.magic_mug_image"},{"type":"image_picker","id":"love_handle_mug_image","label":"t:mug_gallery.love_handle_mug_image"},{"type":"image_picker","id":"inner_red_mug_image","label":"t:mug_gallery.inner_red_mug_image"},{"type":"range","id":"products_per_page","label":"t:mug_gallery.products_per_page","min":12,"max":48,"step":4,"default":24}]}
{% endschema %}
