{% liquid
  assign personalizer_config = product.metafields.cartwala_personalizer.personalizer_config.value
  if personalizer_config == blank
    assign personalizer_config = product.metafields['app--340764327937'].personalizer_config.value
  endif
  assign personalizer_enabled = personalizer_config.enabled
  assign mug_product = false
  assign mug_model = 'white'
  if product.tags contains 'cw-mug'
    assign mug_product = true
  endif
  if product.tags contains 'cw-mug-model-magic'
    assign mug_model = 'magic'
  elsif product.tags contains 'cw-mug-model-love-handle'
    assign mug_model = 'love-handle'
  elsif product.tags contains 'cw-mug-model-red'
    assign mug_model = 'red'
  endif
  assign heart_magic_mirror_fallback = false
  assign round_magic_mirror_fallback = false
  if product.id == 8677823381689
    assign personalizer_enabled = true
    assign heart_magic_mirror_fallback = true
  endif
  if product.id == 8632711381177
    assign personalizer_enabled = true
    assign round_magic_mirror_fallback = true
  endif
  if request.design_mode
    assign personalizer_enabled = true
  endif
%}

{% if personalizer_enabled %}
  {{ 'cartwala-loading.css' | asset_url | stylesheet_tag }}
  <div class="cw-personalizer" data-cw-personalizer data-product-kind="{% if mug_product %}mug{% else %}gift{% endif %}" data-cw-mug-model="{{ mug_model }}" data-label-edit="{{ 'personalizer.edit_again' | t | escape }}" data-label-saved="{{ 'personalizer.saved_preview' | t | escape }}" data-product-id="{{ product.id }}" data-overlay="{% if heart_magic_mirror_fallback %}https://cdn.shopify.com/s/files/1/0803/7931/4361/files/love_shape-overlay_019e41fb-91c2-47b6-8017-ffcfa79af20c.png?v=1789700102{% elsif round_magic_mirror_fallback %}https://cdn.shopify.com/s/files/1/0803/7931/4361/files/round_mirror-overlay_c9c40d22-6f4f-474b-b1a2-fea41fd5e5a9.png?v=1789642979{% else %}{{ personalizer_config.overlayUrl | escape }}{% endif %}" data-accent="#ff6200" data-label-upload="{{ 'personalizer.upload' | t | escape }}" data-label-reset="{{ 'personalizer.reset' | t | escape }}" data-label-zoom="{{ 'personalizer.zoom' | t | escape }}" data-label-rotation="{{ 'personalizer.rotation' | t | escape }}" data-label-change="{{ 'personalizer.change_photo' | t | escape }}" data-label-font="{{ 'personalizer.font' | t | escape }}" data-label-required="{{ 'personalizer.required' | t | escape }}" data-label-file="{{ 'personalizer.choose_file' | t | escape }}" {{ block.shopify_attributes }}>
    {% if heart_magic_mirror_fallback %}
      <div data-cw-config='{"enabled":true,"overlayUrl":"https://cdn.shopify.com/s/files/1/0803/7931/4361/files/love_shape-overlay_019e41fb-91c2-47b6-8017-ffcfa79af20c.png?v=1789700102","canvasRatio":"1254:1254","photoFields":[{"id":"photo-1","label":"1 MASK","maskUrl":"https://cdn.shopify.com/s/files/1/0803/7931/4361/files/psd-photo-mask-1_0cf43e8b-95f1-477d-ba79-84c22c4314bb.png?v=1789700105","x":49.68102073365231,"y":40.82934609250399,"width":63.31738437001595,"height":55.18341307814992,"rotationEnabled":false,"required":true}],"textFields":[],"fileFields":[],"linkFields":[],"customFonts":[]}' hidden></div>
    {% elsif round_magic_mirror_fallback %}
      <div data-cw-config='{"enabled":true,"overlayUrl":"https://cdn.shopify.com/s/files/1/0803/7931/4361/files/round_mirror-overlay_c9c40d22-6f4f-474b-b1a2-fea41fd5e5a9.png?v=1789642979","canvasRatio":"1500:1500","photoFields":[{"id":"photo-1","label":"Photo","maskUrl":"https://cdn.shopify.com/s/files/1/0803/7931/4361/files/psd-photo-mask-1_8fcfb05f-16d4-40fd-a888-58eca941ee50.png?v=1789642981","x":50,"y":50,"width":100,"height":100,"rotationEnabled":false,"required":true}],"textFields":[{"id":"text-1","label":"Add Text","placeholder":"Enter text","required":false}],"fileFields":[],"linkFields":[],"customFonts":[]}' hidden></div>
    {% else %}
      <div data-cw-config="{{ personalizer_config | json | escape }}" hidden></div>
    {% endif %}
    <button class="cw-personalizer__open" type="button" data-cw-open>{{ 'personalizer.customize' | t }}</button>
    {% if mug_product %}
      <section class="cw-mug-preview cw-mug-preview--{{ mug_model }}" data-cw-mug-preview hidden>
        <header class="cw-mug-preview__heading"><div><p>{{ 'mug_preview.eyebrow' | t }}</p><h2>{{ 'mug_preview.views_title' | t }}</h2></div><span>{{ 'mug_preview.live' | t }}</span></header>
        <div class="cw-mug-preview__views" role="group" aria-label="{{ 'mug_preview.views_label' | t | escape }}">
          <figure class="cw-mug-preview__view"><div class="cw-mug-preview__view-stage"><div class="cw-mug-preview__scene" data-cw-mug-scene data-cw-rotation-y="-112" data-cw-rotation-x="-5"></div></div><figcaption>{{ 'mug_preview.left_view' | t }}</figcaption></figure>
          <figure class="cw-mug-preview__view"><div class="cw-mug-preview__view-stage"><div class="cw-mug-preview__scene" data-cw-mug-scene data-cw-rotation-y="0" data-cw-rotation-x="-5"></div></div><figcaption>{{ 'mug_preview.front_view' | t }}</figcaption></figure>
          <figure class="cw-mug-preview__view"><div class="cw-mug-preview__view-stage"><div class="cw-mug-preview__scene" data-cw-mug-scene data-cw-rotation-y="112" data-cw-rotation-x="-5"></div></div><figcaption>{{ 'mug_preview.right_view' | t }}</figcaption></figure>
        </div>
        {% if mug_model == 'magic' %}
          <button class="cw-mug-preview__heat" type="button" data-cw-magic-toggle data-cold-label="{{ 'mug_preview.pour_hot_water' | t | escape }}" data-hot-label="{{ 'mug_preview.cool_magic_mug' | t | escape }}" aria-pressed="false">{{ 'mug_preview.pour_hot_water' | t }}</button>
        {% endif %}
        <button class="cw-mug-preview__open-3d" type="button" data-cw-mug-open commandfor="cw-mug-dialog-{{ block.id }}" command="show-modal" onclick="var dialog=this.closest('[data-cw-personalizer]').querySelector('[data-cw-mug-dialog]');setTimeout(function(){if(dialog&&!dialog.open){if(typeof dialog.showModal==='function'){dialog.showModal();}else{dialog.setAttribute('open','');}}});" aria-label="{{ 'mug_preview.open_3d' | t | escape }}"><span aria-hidden="true">↻</span><strong>3D</strong></button>
      </section>
      <dialog id="cw-mug-dialog-{{ block.id }}" class="cw-mug-modal cw-mug-modal--{{ mug_model }}" data-cw-mug-dialog aria-labelledby="cw-mug-modal-title-{{ block.id }}">
        <div class="cw-mug-modal__panel">
          <header><h2 id="cw-mug-modal-title-{{ block.id }}">{{ 'mug_preview.modal_title' | t }}</h2><button type="button" data-cw-mug-close aria-label="{{ 'personalizer.close' | t | escape }}">×</button></header>
          <div class="cw-mug-modal__stage" data-cw-mug-stage tabindex="0" role="img" aria-label="{{ 'mug_preview.stage_label' | t | escape }}"><div class="cw-mug-preview__scene" data-cw-mug-scene data-cw-rotation-y="-18" data-cw-rotation-x="-8"></div></div>
          <p>{{ 'mug_preview.free_drag_help' | t }}</p>
        </div>
      </dialog>
    {% endif %}
    <dialog class="cw-personalizer__dialog" data-cw-dialog>
      <div class="cw-personalizer__panel">
        <div class="cw-personalizer__header"><div class="cw-personalizer__brand"><span class="cw-personalizer__brand-mark">C</span><strong>Cartwala Customizer</strong></div><button type="button" class="cw-personalizer__close" data-cw-close aria-label="{{ 'personalizer.close' | t }}">×</button></div>
        <div class="cw-personalizer__toolbar"><div class="cw-personalizer__toolbar-left"><button type="button" class="cw-personalizer__toolbar-reset" data-cw-reset-all>↻ Reset</button><button type="button" class="cw-personalizer__toolbar-change" data-cw-change-photo>▣ Change Photo</button></div><button type="button" class="cw-personalizer__preview cw-personalizer__preview--top" data-cw-save disabled>Preview &amp; Save</button></div>
        <div class="cw-personalizer__workspace"><div class="cw-personalizer__canvas-pane"><div class="cw-personalizer__stage" data-cw-stage><div class="cw-personalizer__photo-layers" data-cw-photo-layers></div><div class="cw-personalizer__text-layers" data-cw-text-layers></div><img class="cw-personalizer__overlay" data-cw-overlay alt="" aria-hidden="true" width="1200" height="1200"><div class="cw-personalizer__result" data-cw-result hidden><img data-cw-result-image class="cw-personalizer__result-image" alt="{{ 'personalizer.saved_preview' | t }}" width="800" height="800"></div></div><div class="cw-personalizer__tip"><strong>Tip:</strong> To Move - Swipe / Drag &nbsp; · &nbsp; To Zoom - Pinch in/out / Corners</div></div><aside class="cw-personalizer__controls-pane"><div class="cw-personalizer__fields" data-cw-editor-fields></div></aside></div>
      </div>
    </dialog>
  </div>
  <script src="{{ 'cartwala-direct-checkout.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-cart-retry.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-selection-box.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-editor-ui.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-print-metadata.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-cart-fix.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-loading.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-preview-fit-fix.js' | asset_url }}" defer></script>
  <script src="{{ 'cartwala-stability-fix.js' | asset_url }}" defer></script>
{% endif %}

{% if block.settings.show_delivery_dates %}
  <div
    class="cw-delivery-estimate"
    data-cw-delivery-estimate
    data-dispatch-start="{{ block.settings.dispatch_start_days }}"
    data-dispatch-end="{{ block.settings.dispatch_end_days }}"
    data-delivery-start="{{ block.settings.delivery_start_days }}"
    data-delivery-end="{{ block.settings.delivery_end_days }}"
    data-dispatch-label="{{ 'personalizer.ready_to_dispatch' | t | escape }}"
    data-delivery-label="{{ 'personalizer.estimated_delivery' | t | escape }}"
    aria-live="polite"
    {{ block.shopify_attributes }}
  >
    <div class="cw-delivery-estimate__step">
      <span class="cw-delivery-estimate__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2m-5 6 1.5 1.5L15 12"/></svg></span>
      <strong>{{ 'personalizer.ordered' | t }}</strong>
      <span class="cw-delivery-estimate__date" data-cw-ordered-date></span>
    </div>
    <span class="cw-delivery-estimate__line" aria-hidden="true"></span>
    <div class="cw-delivery-estimate__step">
      <span class="cw-delivery-estimate__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span>
      <strong>{{ 'personalizer.order_ready' | t }}</strong>
      <span class="cw-delivery-estimate__date" data-cw-dispatch-dates></span>
    </div>
    <span class="cw-delivery-estimate__line" aria-hidden="true"></span>
    <div class="cw-delivery-estimate__step">
      <span class="cw-delivery-estimate__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
      <strong>{{ 'personalizer.delivered' | t }}</strong>
      <span class="cw-delivery-estimate__date" data-cw-delivery-dates></span>
    </div>
  </div>
  <script src="{{ 'cartwala-delivery-estimate.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{"name":"t:personalizer.block_name","target":"section","javascript":"cartwala-personalizer.js","stylesheet":"cartwala-personalizer.css","enabled_on":{"templates":["product"]},"settings":[{"type":"color","id":"accent_color","label":"t:personalizer.accent_color","default":"#ff6200"},{"type":"checkbox","id":"show_delivery_dates","label":"t:personalizer.show_delivery_dates","default":true},{"type":"range","id":"dispatch_start_days","label":"t:personalizer.dispatch_start_days","min":0,"max":14,"step":1,"default":2},{"type":"range","id":"dispatch_end_days","label":"t:personalizer.dispatch_end_days","min":0,"max":14,"step":1,"default":3},{"type":"range","id":"delivery_start_days","label":"t:personalizer.delivery_start_days","min":1,"max":30,"step":1,"default":7},{"type":"range","id":"delivery_end_days","label":"t:personalizer.delivery_end_days","min":1,"max":30,"step":1,"default":8}]}
{% endschema %}
